DB_HOST=8.148.75.17
DB_PORT=3306
DB_USER=wy-flj
DB_PASSWORD=your_password
DB_NAME=wy-flj

# 开火偏移区间（毫秒）：实际开火 = 开抢时间 + 随机偏移
# 负数=提前，正数=延后；多账号各自在区间内随机
# 例：[0,100] → 开抢后 0~100ms；[-100,200] → 提前100ms ~ 延后200ms
FIRE_EARLY_MS=[0,100]

# 连续抢购间隔（毫秒），0=上一响应返回后立即下一发
ACQUIRE_INTERVAL_MS=0

# ---------- 抢购出口代理（缓解同 IP 多账号触发「活动太火爆」）----------
# 1=开启：开抢前按任务提取 IP，经网易 server/time 质检后分配；未分到直连
RUSH_PROXY_ENABLED=1
# 供应商：shachen=闪臣 | zdaye=站大爷短效纯生版 ShortEdgeProxy
RUSH_PROXY_PROVIDER=shachen
# 质检：经代理访问 pay-api .../server/time；到点立刻中断（Abort），不等慢响应回来再舍弃
RUSH_PROXY_QUALITY_MAX_MS=1500
# 开抢前多久停止分配（毫秒）；到点未分完的任务改直连，不拖开火
RUSH_PROXY_STOP_BEFORE_RUSH_MS=5000
# 开抢前多久开始分配（毫秒，默认 120000=开抢前 2 分钟）
# RUSH_PROXY_ALLOC_LEAD_MS=120000
# 单账号开抢前预热超时（毫秒），避免某个代理无响应拖死全体
# SECKILL_WARMUP_TIMEOUT_MS=10000
# 本机公网 IP（白名单）；空则自动探测
# RUSH_PROXY_WHITELIST_IP=

# ---- 闪臣（RUSH_PROXY_PROVIDER=shachen 时生效）----
RUSH_PROXY_APP_KEY=
RUSH_PROXY_SECURITY_CODE=
# RUSH_PROXY_PACKAGE_KEY=
RUSH_PROXY_API_BASE=https://sch.shanchendaili.com/api.html
RUSH_PROXY_IP_TIME_MINUTES=5

# ---- 站大爷（RUSH_PROXY_PROVIDER=zdaye 时生效）----
