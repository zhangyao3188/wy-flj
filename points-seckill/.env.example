DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wy-flj
DB_PASSWORD=your_password
DB_NAME=wy-flj

# 正式抢购开抢时间（yyyy-mm-dd hh:mm:ss），npm run dev 使用
POINTS_SECKILL_START_AT=2026-08-26 20:00:00

# 连续兑换间隔（毫秒）：0=上一请求结束后立刻下一轮
ACQUIRE_INTERVAL_MS=0

# 开抢时商品列表旁路轮询间隔（毫秒）：按 prizeName 匹配热切换 exchangeId
GOODS_WATCH_INTERVAL_MS=0

# 开抢前多少毫秒预热兑换接口（0=关闭）
ACQUIRE_WARMUP_MS=5000

# 开火偏移区间（毫秒）：实际开火 = 开抢时间 + 随机偏移
FIRE_EARLY_MS=[0,10]
